datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Inquiry {
  id            String   @id @default(uuid())
  name          String
  contactNumber String
  email         String
  requirement   String
  createdAt     DateTime @default(now())
}

model Banner {
  id        String   @id @default(uuid())
  slot      Int      @unique  // 1, 2, or 3
  imageUrl  String
  heading1  String?
  heading2  String?
  heading3  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}
